<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- A V inside a rounded box, so the mark reads as "Vbox" at launcher sizes.
         The frame stays inside the 66dp adaptive safe zone.
         The API 21-25 bitmaps in mipmap-*/ic_launcher.png mirror this geometry;
         regenerate them with buildScript/tools/gen_launcher_icon.py after edits. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M41,26 L67,26 A15,15 0 0 1 82,41 L82,67 A15,15 0 0 1 67,82 L41,82 A15,15 0 0 1 26,67 L26,41 A15,15 0 0 1 41,26 Z"
        android:strokeColor="#4F9593"
        android:strokeWidth="2.5" />

    <!-- Right arm is painted first; the white left arm closes over the joint, so the
         monogram reads as one folded stroke instead of two overlapping lines. -->
    <path
        android:pathData="M54,70 L68,40"
        android:strokeColor="#9FE0D6"
        android:strokeLineCap="round"
        android:strokeWidth="9" />
    <path
        android:pathData="M40,40 L54,70"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="9" />
</vector>
